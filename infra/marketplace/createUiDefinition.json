{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      { "name": "operatorObjectId", "type": "Microsoft.Common.TextBox", "label": "AKS administrator object ID", "toolTip": "Microsoft Entra object ID granted AKS administrator access.", "constraints": { "required": true, "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", "validationMessage": "Enter a Microsoft Entra object ID." } },
      { "name": "environment", "type": "Microsoft.Common.DropDown", "label": "Environment", "defaultValue": "dev", "constraints": { "required": true, "allowedValues": [ { "label": "dev", "value": "dev" }, { "label": "stage", "value": "stage" }, { "label": "prod", "value": "prod" } ] } }
    ],
    "steps": [
      { "name": "capacity", "label": "Capacity and cost", "subLabel": "Budget-safe defaults", "elements": [
        { "name": "nodeSize", "type": "Microsoft.Common.DropDown", "label": "Worker size", "defaultValue": "Standard_B2s", "constraints": { "allowedValues": [ { "label": "B2s — budget default", "value": "Standard_B2s" }, { "label": "D2s v5 — performance", "value": "Standard_D2s_v5" } ] } },
        { "name": "maxWorkers", "type": "Microsoft.Common.Slider", "label": "Maximum workers", "defaultValue": 2, "min": 1, "max": 4, "step": 1, "showStepMarkers": true },
        { "name": "enableNatGateway", "type": "Microsoft.Common.CheckBox", "label": "Dedicated NAT Gateway", "defaultValue": false, "toolTip": "Adds a billable NAT Gateway and public IP." }
      ] }
    ],
    "outputs": {
      "location": "[location()]",
      "environment": "[basics('environment')]",
      "operatorObjectId": "[basics('operatorObjectId')]",
      "nodeSize": "[steps('capacity').nodeSize]",
      "minWorkers": 1,
      "maxWorkers": "[steps('capacity').maxWorkers]",
      "enableNatGateway": "[steps('capacity').enableNatGateway]"
    }
  }
}
