{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "basics": {
        "description": "Choose an existing resource group or create one, for example `rg-kaveon-dev`. Kaveon uses the name you choose. This preview provisions Azure infrastructure and Microsoft Entra sign-in. Your account becomes the first administrator. Studio installation is a separate step.",
        "location": {
          "label": "Region",
          "resourceTypes": [
            "Microsoft.ContainerService/managedClusters",
            "Microsoft.Storage/storageAccounts",
            "Microsoft.ContainerRegistry/registries"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "installationName",
        "type": "Microsoft.Common.TextBox",
        "label": "Installation name",
        "placeholder": "e.g. analytics",
        "toolTip": "Used to name this installation’s Azure resources. Use the same name and environment when updating it.",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9-]{1,14}[a-z0-9]$",
          "validationMessage": "Use 3–16 lowercase letters, numbers or hyphens. Start with a letter and end with a letter or number."
        },
        "visible": true
      },
      {
        "name": "environment",
        "type": "Microsoft.Common.DropDown",
        "label": "Environment",
        "defaultValue": "Development",
        "toolTip": "Included in resource names. Choose the environment this installation will serve.",
        "constraints": {
          "required": true,
          "allowedValues": [
            {
              "label": "Development",
              "value": "dev"
            },
            {
              "label": "Staging",
              "value": "stage"
            },
            {
              "label": "Production",
              "value": "prod"
            }
          ]
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "capacity",
        "label": "Compute",
        "subLabel": {
          "preValidation": "Choose worker capacity",
          "postValidation": "Worker capacity configured"
        },
        "bladeTitle": "Compute",
        "elements": [
          {
            "name": "billing",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "AKS starts with two D4s v5 system nodes and one worker. All three incur compute charges while running. The worker limit caps autoscaling."
            }
          },
          {
            "name": "nodeSize",
            "type": "Microsoft.Common.DropDown",
            "label": "Worker size",
            "defaultValue": "Standard B2s",
            "toolTip": "VM size for query workers. Availability depends on regional capacity and subscription quota.",
            "constraints": {
              "required": true,
              "allowedValues": [
                {
                  "label": "Standard B2s",
                  "value": "Standard_B2s"
                },
                {
                  "label": "Standard D2s v5",
                  "value": "Standard_D2s_v5"
                }
              ]
            },
            "visible": true
          },
          {
            "name": "maxWorkers",
            "type": "Microsoft.Common.DropDown",
            "label": "Maximum workers",
            "toolTip": "AKS can scale the worker pool from one node up to this limit.",
            "defaultValue": "2 workers",
            "constraints": {
              "required": true,
              "allowedValues": [
                { "label": "1 worker", "value": "1" },
                { "label": "2 workers", "value": "2" },
                { "label": "3 workers", "value": "3" },
                { "label": "4 workers", "value": "4" }
              ]
            },
            "visible": true
          }
        ]
      }
    ],
    "outputs": {
      "installationName": "[basics('installationName')]",
      "environment": "[basics('environment')]",
      "location": "[location()]",
      "nodeSize": "[steps('capacity').nodeSize]",
      "maxWorkers": "[int(steps('capacity').maxWorkers)]"
    }
  }
}
