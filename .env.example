# =============================================================================
# LoomX Root Configuration Template
# Copy this to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Ports
# -----------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000
PYTHON_PROXY_PORT=5001

# -----------------------------------------------------------------------------
# Azure AD Configuration (Shared by API and Web)
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# -----------------------------------------------------------------------------
# Metadata Database (Used by API and Python Proxy)
# Stores LoomX app data: datasets, charts, dashboards, data_sources table, etc.
# Data warehouse endpoints are retrieved from the data_sources table dynamically
# Users configure warehouses via the UI at /data-sources
#
# Optional — if omitted, LoomX shows a setup wizard on first login where
# you can enter and test the connection directly from the browser.
# -----------------------------------------------------------------------------
# FABRIC_METADATA_ENDPOINT=your-endpoint.msit-database.fabric.microsoft.com
# FABRIC_METADATA_DATABASE=your-database-name

# -----------------------------------------------------------------------------
# Internal Service URLs (usually don't need to change)
# -----------------------------------------------------------------------------
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000
PYTHON_PROXY_URL=http://localhost:5001

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
