# =============================================================================
# Lens — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values you need.
#
# QUICK START (UI-configured):
#   Only the variables in the "Required" section below are needed.
#   Everything else is configured through the Lens UI after first launch.
#
# DEPLOYMENT (pre-configured):
#   Uncomment and fill in the optional sections to skip the setup wizard
#   and pre-configure auth/database from your deployment pipeline.
# =============================================================================


# ── Required ──────────────────────────────────────────────────────────────────

NODE_ENV=production

API_PORT=8080
WEB_PORT=3000

API_URL=http://localhost:8080
WEB_URL=http://localhost:3000


# ── Metadata Database  (optional — skips setup wizard if set) ─────────────────
# Supported types: fabric_sql | azure_sql | postgresql | mysql
#
# Microsoft Fabric SQL / Azure SQL:
# METADATA_DB_TYPE=fabric_sql
# METADATA_ENDPOINT=xyz.msit-database.fabric.microsoft.com
# METADATA_DATABASE=lens
#
# PostgreSQL:
# METADATA_DB_TYPE=postgresql
# METADATA_HOST=localhost
# METADATA_PORT=5432
# METADATA_DATABASE=lens
#
# MySQL / MariaDB:
# METADATA_DB_TYPE=mysql
# METADATA_HOST=localhost
# METADATA_PORT=3306
# METADATA_DATABASE=lens


# ── Authentication  (optional — defaults to local login if omitted) ────────────
# Auth provider can also be configured from Settings → Authentication in the UI.
#
# Azure Active Directory:
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Google OAuth2 — client secret is entered in the UI (Settings → Authentication)
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com


# ── Encryption  (recommended for production) ──────────────────────────────────
# Fernet key used to encrypt AI provider keys and JWT secrets in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, a random key is generated at startup — encrypted secrets are lost on restart.
#
# AI_ENCRYPTION_SECRET=your-base64-fernet-key-here
