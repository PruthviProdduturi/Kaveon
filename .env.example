# =============================================================================
# Kaveon — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values you need.
#
# QUICK START (UI-configured):
#   Only the variables in the "Required" section below are needed.
#   Everything else is configured through the Kaveon UI after first launch.
#
# DEPLOYMENT (pre-configured):
#   Uncomment and fill in the optional sections to skip the setup wizard
#   and pre-configure auth/database from your deployment pipeline.
# =============================================================================


# ── Required ──────────────────────────────────────────────────────────────────

NODE_ENV=production

API_PORT=8080
WEB_PORT=3000

API_URL=http://localhost:8080
WEB_URL=http://localhost:3000


# ── Metadata Database  (optional — skips setup wizard if set) ─────────────────
# Supported types: fabric_sql | azure_sql | postgresql | mysql
#
# Microsoft Fabric SQL / Azure SQL:
# METADATA_DB_TYPE=fabric_sql
# METADATA_ENDPOINT=xyz.msit-database.fabric.microsoft.com
# METADATA_DATABASE=kaveon
#
# PostgreSQL (incl. Neon / Supabase — set USER+PASSWORD for standard auth):
# METADATA_DB_TYPE=postgresql
# METADATA_HOST=localhost            # or <id>.neon.tech
# METADATA_PORT=5432
# METADATA_DATABASE=kaveon
# METADATA_USER=kaveon_user          # omit USER+PASSWORD to use Azure AD instead
# METADATA_PASSWORD=your-password
# METADATA_SSLMODE=require           # Neon/Supabase require TLS
#
# MySQL / MariaDB:
# METADATA_DB_TYPE=mysql
# METADATA_HOST=localhost
# METADATA_PORT=3306
# METADATA_DATABASE=kaveon


# ── Authentication — NextAuth (OAuth only: GitHub, Google, Microsoft) ──────────
# Kaveon signs in via NextAuth inside the web app (no local password, no gateway).
# A provider's button appears automatically when its id/secret are set.
#
# Required: signing secret for the session (generate: openssl rand -base64 32)
# AUTH_SECRET=
# Public URL of the web app (needed in production; auto-detected in dev):
# AUTH_URL=http://localhost:3000
# Emails that should get the Admin role (comma-separated); others get Viewer:
# AUTH_ADMIN_EMAILS=pruthvi.prodduturi@gmail.com
#
# GitHub OAuth App — https://github.com/settings/developers
#   Homepage: http://localhost:3000 · Callback: http://localhost:3000/api/auth/callback/github
# GITHUB_ID=
# GITHUB_SECRET=
#
# Google OAuth — https://console.cloud.google.com/apis/credentials
#   Authorized redirect: http://localhost:3000/api/auth/callback/google
# GOOGLE_ID=
# GOOGLE_SECRET=
#
# Microsoft Entra ID — https://portal.azure.com → App registrations
#   Redirect (Web): http://localhost:3000/api/auth/callback/microsoft-entra-id
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# ── API identity bridge (Forge-style) ─────────────────────────────────────────
# The kaveon-web proxy (/api/kaveon/*) authenticates the NextAuth session server-side
# and forwards X-User-* identity headers to kaveon-api, stamped with this shared
# secret. kaveon-api trusts those headers only when the secret matches. Set the
# SAME value here (read by both apps). Generate: openssl rand -hex 24
# KAVEON_PROXY_SECRET=
# Local dev bypass for kaveon-api only (skip auth when hitting :8080 directly):
# KAVEON_DEV_USER_EMAIL=
# KAVEON_DEV_USER_NAME=Dev User
# KAVEON_DEV_USER_ROLE=Admin


# ── Encryption  (recommended for production) ──────────────────────────────────
# Fernet key used to encrypt AI provider keys and JWT secrets in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, a random key is generated at startup — encrypted secrets are lost on restart.
#
# AI_ENCRYPTION_SECRET=your-base64-fernet-key-here


# ── Rate Limiting  (optional — production) ───────────────────────────────────
# Redis URL for distributed rate limiting. Falls back to in-process counters
# without it — fine for single-worker dev, but multi-worker production needs Redis.
# REDIS_URL=redis://localhost:6379/0


# ── Additional Databases  (optional) ─────────────────────────────────────────
# Comma-separated list of additional databases on the same AAD-auth Postgres server
# (beyond the metadata DB). Used when the data warehouse is a separate DB on the
# same host and you want AAD token auth for both.
# AAD_DATABASES=kaveon_warehouse,analytics
