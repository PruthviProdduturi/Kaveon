# =============================================================================
# LoomX Root Configuration Template
# Copy this to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Ports
# -----------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Azure AD Configuration
# AZURE_* is read by the Next.js frontend (MSAL sign-in).
# The API also accepts AZURE_* as a fallback if AAD_* are not set,
# so you only need one set of values here.
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# -----------------------------------------------------------------------------
# Metadata Database (Used by the Python/FastAPI API)
# Stores LoomX app data: datasets, charts, dashboards, data_sources, etc.
# Data warehouse endpoints are retrieved from the data_sources table dynamically
# Users configure warehouses via the UI at /data-sources
#
# Optional — if omitted, LoomX shows a first-run setup wizard where you can
# enter and test the connection directly from the browser.
# -----------------------------------------------------------------------------
# METADATA_ENDPOINT=your-endpoint.msit-database.fabric.microsoft.com
# METADATA_DATABASE=your-database-name

# -----------------------------------------------------------------------------
# Internal Service URLs
# -----------------------------------------------------------------------------
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000
