  "sql": "SELECT d.region, COUNT(*) AS n, SUM(e.actions) AS total_actions FROM kaveon_events_enriched e JOIN kaveon_events_dashboard d ON e.region = d.region WHERE e.event_date = DATE '2026-07-04' GROUP BY d.region ORDER BY d.region"
